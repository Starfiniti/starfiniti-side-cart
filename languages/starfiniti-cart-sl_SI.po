#: src/AddOn/SpecialAddOn.php:135
msgid "That special add-on is no longer available."
msgstr "Dodatek ni več na voljo."

#: src/AddOn/SpecialAddOn.php:309
msgid "That special add-on is unavailable."
msgstr "Dodatek ni na voljo."

#: src/AddOn/SpecialAddOn.php:321 src/AddOn/SpecialAddOn.php:335
msgid "Choose an available add-on variation."
msgstr "Izberite razpoložljivo različico dodatka."

#: src/AddOn/SpecialAddOn.php:328
msgid "Choose all add-on options before selecting it."
msgstr "Pred izbiro dodatka izberite vse možnosti."

#: src/AddOn/SpecialAddOn.php:367
msgid "That special add-on could not be added."
msgstr "Dodatka ni bilo mogoče dodati."

#: src/Ajax/CartController.php:76
msgid "Choose a valid cart item quantity."
msgstr "Izberite veljavno količino."

#: src/Ajax/CartController.php:82 src/Ajax/CartController.php:169
msgid "That cart item could not be found."
msgstr "Izdelka v košarici ni bilo mogoče najti."

#: src/Ajax/CartController.php:88 src/Ajax/CartController.php:255
msgid "That product is unavailable."
msgstr "Izdelek ni na voljo."

#: src/Ajax/CartController.php:92
msgid "This cart item has a fixed quantity."
msgstr "Količine tega izdelka ni mogoče spremeniti."

#: src/Ajax/CartController.php:98
msgid "Choose a whole-number cart item quantity."
msgstr "Količina mora biti celo število."

#: src/Ajax/CartController.php:110
msgid "The cart item quantity could not be updated."
msgstr "Količine ni bilo mogoče spremeniti."

#: src/Ajax/CartController.php:122
#, php-format
msgid "“%s” was updated."
msgstr "Izdelek »%s« je posodobljen."

#: src/Ajax/CartController.php:145
msgid "Special add-on selected."
msgstr "Dodatek je izbran."

#: src/Ajax/CartController.php:146
msgid "Special add-on removed."
msgstr "Dodatek je odstranjen."

#: src/Ajax/CartController.php:173
msgid "This reward gift cannot be removed."
msgstr "Tega darila ni mogoče odstraniti."

#: src/Ajax/CartController.php:191
msgid "Coupons are not enabled for this store."
msgstr "Ta trgovina ne sprejema kuponov."

#: src/Ajax/CartController.php:197
msgid "Enter a coupon code."
msgstr "Vnesite kodo kupona."

#: src/Ajax/CartController.php:202
msgid "That coupon could not be applied."
msgstr "Kupona ni bilo mogoče uporabiti."

#: src/Ajax/CartController.php:225
msgid "That coupon is not applied to the cart."
msgstr "Ta kupon ni uporabljen v košarici."

#: src/Ajax/CartController.php:228
msgid "Coupon removed."
msgstr "Kupon je odstranjen."

#: src/Ajax/CartController.php:249
msgid "That recommendation is no longer available."
msgstr "Priporočeni izdelek ni več na voljo."

#: src/Ajax/CartController.php:280
msgid "That product could not be added to your cart."
msgstr "Izdelka ni bilo mogoče dodati v košarico."

#: src/Ajax/CartController.php:294
#, php-format
msgid "“%s” was added to your cart."
msgstr "Izdelek »%s« je dodan v košarico."

#: src/Ajax/CartController.php:308 src/Ajax/CartController.php:336
msgid "Too many cart events were received. Try again later."
msgstr "Preveč zahtevkov. Poskusite pozneje."

#: src/Ajax/CartController.php:333
msgid "That analytics event is not supported."
msgstr "Ta dogodek ni podprt."

#: src/Ajax/CartController.php:353
msgid "The cart event could not be recorded."
msgstr "Dogodka ni bilo mogoče zabeležiti."

#: src/Ajax/CartController.php:422
msgid "Choose an available product variation."
msgstr "Izberite razpoložljivo različico izdelka."

#: src/Ajax/CartController.php:428
msgid "Choose options for this product before adding it."
msgstr "Pred dodajanjem izberite možnosti izdelka."

#: src/Ajax/CartController.php:457
#, php-format
msgid "The minimum allowed quantity is %s."
msgstr "Najmanjša dovoljena količina je %s."

#: src/Ajax/CartController.php:462
#, php-format
msgid "The maximum allowed quantity is %s."
msgstr "Največja dovoljena količina je %s."

#: src/Ajax/CartController.php:467
#, php-format
msgid "Quantity must increase in steps of %s."
msgstr "Količino lahko spreminjate po %s."

#: src/Ajax/CartController.php:474
msgid "That quantity is not available."
msgstr "Te količine ni na zalogi."

#: src/Ajax/CartController.php:491
#, php-format
msgid "Only %s is currently available."
msgstr "Trenutno je na voljo samo %s."

#: src/Ajax/CartController.php:504
msgid "The cart item could not be removed."
msgstr "Izdelka ni bilo mogoče odstraniti."

#: src/Ajax/CartController.php:515
#, php-format
msgid "“%s” was removed from your cart."
msgstr "Izdelek »%s« je odstranjen iz košarice."

#: src/Ajax/CartController.php:526 src/Cart/CartState.php:33
msgid "The WooCommerce cart is unavailable."
msgstr "Košarica trenutno ni na voljo."

#: src/Ajax/CartController.php:540
msgid "Your cart session expired. Refresh the page and try again."
msgstr "Seja košarice je potekla. Osvežite stran in poskusite znova."

#: src/Ajax/CartController.php:603
msgid "The cart could not be refreshed."
msgstr "Košarice ni bilo mogoče osvežiti."

#: src/Ajax/CartController.php:628
msgid "The cart could not be updated. Please try again."
msgstr "Košarice ni bilo mogoče posodobiti. Poskusite znova."

#: src/Analytics/Privacy.php:76 src/Analytics/Privacy.php:92 src/Analytics/Privacy.php:114
