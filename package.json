{
  "name": "starfiniti-cart",
  "version": "1.4.2",
  "private": true,
  "description": "Build tooling for Starfiniti Cart for WooCommerce.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format .github/workflows/ci.yml assets blocks playground scripts tests/e2e playwright.config.ts webpack.config.js",
    "lint:js": "wp-scripts lint-js assets scripts tests/e2e tests/js playwright.config.ts webpack.config.js",
    "lint:style": "wp-scripts lint-style \"assets/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "wp-scripts test-unit-js --runInBand --passWithNoTests",
    "playground": "wp-playground-cli start --blueprint=playground/blueprint.json",
    "playground:ci": "wp-playground-cli server --blueprint=playground/blueprint.json --mount-before-install=.:/wordpress/wp-content/plugins/starfiniti-cart --port=9400",
    "test:e2e": "playwright test",
    "test:playground-conflict": "wp-playground-cli run-blueprint --blueprint=playground/conflict-blueprint.json --mount-before-install=.:/wordpress/wp-content/plugins/starfiniti-cart",
    "check": "npm run lint:js && npm run lint:style && npm run typecheck && npm run test:unit && npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wordpress/api-fetch": "7.51.0",
    "@wordpress/block-editor": "15.14.0",
    "@wordpress/blocks": "15.14.0",
    "@wordpress/components": "37.0.0",
    "@wordpress/element": "8.3.0",
    "@wordpress/i18n": "6.9.0",
    "@wordpress/scripts": "33.0.0",
    "@wp-playground/cli": "3.1.45",
    "archiver": "8.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "lucide": "^1.25.0",
    "lucide-react": "^1.25.0",
    "sass": "1.101.0",
    "typescript": "5.9.3"
  }
}
